{
  "name": "ledger-mcp",
  "version": "0.1.1",
  "private": true,
  "description": "Intuit's QuickBooks Online MCP server, served remotely over HTTPS with OAuth sign-in and an email allowlist",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "tsc -p tsconfig.json && node --test --test-reporter=spec dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@qboapi/qbo-mcp-server": "git+https://github.com/intuit/quickbooks-online-mcp-server.git#31a1dd5c3e170e368dbff651abbaf61aabde6ed9",
    "express": "^5.2.1",
    "intuit-oauth": "^4.2.5",
    "jose": "^6.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "node-quickbooks": {
      "fast-xml-parser": "^5.10.1",
      "underscore": "^1.13.8",
      "uuid": "11.1.1"
    }
  }
}
