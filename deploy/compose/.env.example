# Copy to .env and fill in. .env holds secrets: never commit it.

# The public name this server answers on. DNS must point it at this host.
LEDGER_HOSTNAME=ledger.example.com
# Image version; see the repository's releases.
LEDGER_VERSION=0.1.0

# --- Secrets ---------------------------------------------------------------------------
# openssl rand -base64 32. Changing it later signs everyone out.
SEAL_KEY=
# Google (or other OIDC) web client; redirect URI https://LEDGER_HOSTNAME/auth/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Intuit app keys. Development keys with QUICKBOOKS_ENVIRONMENT=sandbox, production keys with
# production; redirect URI https://LEDGER_HOSTNAME/qbo/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

# --- Who may use it --------------------------------------------------------------------
# Addresses, or *@domain for everyone at exactly that domain.
ALLOWED_EMAILS=alice@example.com,*@example.com
# Exact addresses who may connect or disconnect the QuickBooks company.
ADMIN_EMAILS=alice@example.com
# Uncomment to use another OpenID Connect provider than Google.
# OIDC_ISSUER=https://accounts.google.com

# --- What the public pages and legal terms say -----------------------------------------
# No "QuickBooks", "QB", "QBO" or "Intuit" in the name; Intuit rejects it.
APP_NAME=Ledger Bridge
OPERATOR_NAME=Example Co LLC
CONTACT_EMAIL=alice@example.com
LEGAL_EFFECTIVE_DATE=January 1, 2026
GOVERNING_LAW=the State of Delaware
GOVERNING_VENUE=New Castle County, Delaware
HOSTING_LOCATION=the United States

# Upstream's switches. Read tools are always available.
QUICKBOOKS_DISABLE_WRITE=false
QUICKBOOKS_DISABLE_UPDATE=false
QUICKBOOKS_DISABLE_DELETE=false
